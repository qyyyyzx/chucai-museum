    "@dcloudio/uni-ui": "latest",
    "@dcloudio/vite-plugin-uni": "vue3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.104.1",
