{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/exhibit/list",
      "style": {
        "navigationBarTitleText": "楚菜展陈",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/exhibit/detail",
      "style": {
        "navigationBarTitleText": "展品详情"
      }
    },
    {
      "path": "pages/exhibit/story",
      "style": {
        "navigationBarTitleText": "菜品故事"
      }
    },
    {
      "path": "pages/shared/components-demo",
      "style": {
        "navigationBarTitleText": "通用组件示例"
      }
    },
    {
      "path": "pages/social/checkin",
      "style": {
        "navigationBarTitleText": "社交打卡"
      }
    },
    {
      "path": "pages/lbs/nearby",
      "style": {
        "navigationBarTitleText": "附近餐厅"
      }
    },
    {
      "path": "pages/lbs/chumap",
      "style": {
        "navigationBarTitleText": "筷乐寻楚"
      }
    },
    {
      "path": "pages/user/profile",
      "style": {
        "navigationBarTitleText": "个人信息"
      }
    }
  ],
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#2979ff",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/exhibit/list",
        "text": "展陈"
      },
      {
        "pagePath": "pages/lbs/nearby",
        "text": "附近"
      },
      {
        "pagePath": "pages/lbs/chumap",
        "text": "楚菜"
      },
      {
        "pagePath": "pages/social/checkin",
        "text": "打卡"
      },
      {
        "pagePath": "pages/user/profile",
        "text": "我的"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "楚菜文化数字博物馆",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f5f5"
  }
}
